{
  "manifest_version": 3,
  "name": "Выбираем вместе",
  "short_name": "Вместе",
  "version": "1.1.0",
  "description": "Добавляет товары Ozon, Яндекс Маркета и AliExpress в подборку «Выбираем вместе»: страница товара читается прямо в вашем браузере.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Добавить этот товар в подборку",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["product-import.js", "background.js"]
  },
  "permissions": ["scripting"],
  "host_permissions": [
    "https://*.ozon.ru/*", "https://ozon.ru/*", "https://*.ozon.by/*", "https://*.ozon.kz/*", "https://ozon.onelink.me/*",
    "https://market.yandex.ru/*", "https://market.yandex.by/*", "https://market.yandex.kz/*", "https://ya.cc/*",
    "https://*.aliexpress.ru/*", "https://aliexpress.ru/*", "https://*.aliexpress.com/*", "https://aliexpress.com/*",
    "https://*.aliexpress.us/*", "https://aliclick.shop/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://yaroslaz.github.io/markets-pars/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://yaroslaz.github.io/markets-pars/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["relay.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": { "id": "vybiraem-vmeste@example.org", "strict_min_version": "128.0" }
  }
}
